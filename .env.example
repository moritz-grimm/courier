# Port the application runs on (optional, default: 3000)
PORT=3000

# Shared secret, checked against ?token= (required, at least 32 characters)
# Generate one with: openssl rand -hex 32 or node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RELAY_TOKEN=""

# Comma-separated IP addresses excluded from the rate limiter (optional)
RATELIMIT_WHITELIST=""

# Base URL of the ntfy server (required)
NTFY_URL="https://ntfy.example.com"

# ntfy auth: set either NTFY_TOKEN, or NTFY_USERNAME and NTFY_PASSWORD.
# If both are set, the token wins and basic auth is ignored.
NTFY_TOKEN=""
NTFY_USERNAME=""
NTFY_PASSWORD=""
